# Modelo de configuração do frontend. Copie para .env.
# Só variáveis com o prefixo VITE_ ficam visíveis para o código do navegador.

# Endereço do backend
VITE_API_URL=http://localhost:3001

# Entrar com o Google. É o MESMO valor do GOOGLE_CLIENT_ID do backend.
# Vazio ou ausente: o botão (e a linha "ou") simplesmente não aparecem, e a
# tela de entrada continua funcionando com senha.
VITE_GOOGLE_CLIENT_ID=
