# Modelo de configuração. Copie para .env e ajuste os valores.
# Este arquivo VAI para o Git; o .env NÃO vai.

# Conexão com o PostgreSQL (bate com o docker-compose.yml da raiz)
DATABASE_URL=postgres://assfin:assfin_dev@localhost:5432/assfinanceiro

# Porta em que o backend escuta
PORT=3001

# Endereço do frontend autorizado a chamar esta API
CORS_ORIGIN=http://localhost:5173

# Segredo usado para assinar os tokens de login (JWT).
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-valor-aleatorio

# Entrar com o Google. É o MESMO valor do VITE_GOOGLE_CLIENT_ID do frontend.
# Não é segredo (aparece no HTML da página); serve para o backend recusar
# tokens do Google emitidos para outro aplicativo.
# Deixe vazio para desligar o botão: o app continua funcionando com senha.
# Onde pegar: console.cloud.google.com → APIs e Serviços → Credenciais →
# Criar credenciais → ID do cliente OAuth → Aplicativo da Web.
GOOGLE_CLIENT_ID=
