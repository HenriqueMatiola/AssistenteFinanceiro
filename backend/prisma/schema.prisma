// Modelos de dados do Assistente Financeiro.
// Depois de mexer aqui, rode:  npx prisma migrate dev --name <descricao>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  login     String   @unique

  /// O segundo jeito de entrar: a tela de login aceita o nome de usuário ou
  /// o e-mail. Opcional porque contas criadas antes deste campo não têm um —
  /// elas continuam entrando pelo nome de usuário.
  email     String?  @unique

  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em")

  transacoes    Transacao[]
  recorrencias  Recorrencia[]
  operacoes     Operacao[]

  @@map("usuarios")
}

/// Um lançamento: dinheiro que entrou (GANHO) ou que saiu (GASTO).
model Transacao {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")

  /// Só o dia, sem hora: evita que fuso horário jogue o lançamento para outro mês.
  data      DateTime @db.Date

  /// O que foi (Netflix, Cabelo). A categoria diz de que grupo é; a
  /// descrição diz qual item. Sem ela, distinguir Netflix de Spotify exigiria
  /// inventar uma categoria para cada um.
  descricao String

  /// Decimal (NUMERIC no Postgres) faz contas exatas com centavos.
  /// Sempre positivo — quem diz se soma ou subtrai é o campo `tipo`.
  valor     Decimal  @db.Decimal(12, 2)

  categoria String
  tipo      TipoTransacao

  /// Se o dinheiro já se moveu ou ainda vai se mover. É o que separa
  /// "quanto já gastei" de "quanto vou gastar" no Dashboard.
  status    StatusTransacao @default(CONCLUIDA)

  /// Pix, Cartão Nubank, Dinheiro… Texto livre, e não lista fixa: os cartões
  /// de cada pessoa são outros. Vazio quando não se aplica.
  formaDePagamento String? @map("forma_de_pagamento")

  /// Gasto fixo (repete todo mês) ou variável. Só faz sentido para GASTO.
  classificacao ClassificacaoGasto?

  /// Parcelamento: "3/12" vira parcelaAtual 3 e parcelasTotais 12.
  /// Nulos quando a compra foi à vista.
  parcelaAtual   Int? @map("parcela_atual")
  parcelasTotais Int? @map("parcelas_totais")

  /// Marca o lançamento como o dinheiro que veio do mês passado, e não
  /// como uma receita nova.
  ///
  /// Serve para quem começa a usar o app no meio da vida: sem isto, o
  /// primeiro mês mostraria sobra zero mesmo havendo dinheiro em conta.
  /// Um lançamento assim fica fora das entradas, do gráfico de categorias
  /// e das faturas — ele não é gasto nem ganho do mês, é o ponto de
  /// partida dele.
  ehSobraDoMesAnterior Boolean @default(false) @map("eh_sobra_do_mes_anterior")

  /// Liga entre si as parcelas da MESMA compra, para dar para apagar as 12 de
  /// uma vez em vez de caçar uma por uma.
  grupoDeParcelas String? @map("grupo_de_parcelas") @db.Uuid

  /// De qual recorrência este lançamento nasceu, quando nasceu de uma.
  /// É o que impede o balanço de contar a mesma conta duas vezes: enquanto
  /// não existe o lançamento, vale a previsão; assim que ele existe, a
  /// previsão daquele mês para de contar.
  recorrenciaId Int? @map("recorrencia_id")

  criadoEm  DateTime @default(now()) @map("criado_em")

  // Apagar um usuário apaga as transações dele junto.
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Apagar a recorrência não apaga os lançamentos que já aconteceram: eles
  // são fatos, e continuam valendo sem a origem.
  recorrencia Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  // Toda consulta é "transações deste usuário, neste período".
  @@index([usuarioId, data])
  // Apagar ou listar uma compra parcelada inteira.
  @@index([grupoDeParcelas])
  // "Esta recorrência já foi lançada neste mês?" — a pergunta do balanço.
  @@index([recorrenciaId, data])
  @@map("transacoes")
}

/// Uma conta que se repete todo mês (aluguel, assinatura, salário).
/// Não vira lançamento sozinha: serve para o motor de projeção estimar
/// os meses que ainda não aconteceram.
model Recorrencia {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")

  descricao String
  valor     Decimal  @db.Decimal(12, 2)
  categoria String
  tipo      TipoTransacao

  /// Mesmos campos da transação: quando a recorrência virar lançamento, ela
  /// já traz de onde sai o dinheiro e se é gasto fixo.
  formaDePagamento String? @map("forma_de_pagamento")
  classificacao    ClassificacaoGasto?

  /// 1 a 31. Não muda o saldo do mês — a recorrência conta uma vez, caindo
  /// no dia que cair. Serve para mostrar a data prevista; num mês mais curto
  /// que o dia escolhido, a projeção exibe o último dia do mês.
  diaDoMes  Int      @map("dia_do_mes")

  /// Desligar em vez de apagar: uma assinatura cancelada some da projeção
  /// mas continua no histórico.
  ativa     Boolean  @default(true)

  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Lançamentos que já nasceram desta recorrência.
  lancamentos Transacao[]

  // A projeção sempre pede "as recorrências ativas deste usuário".
  @@index([usuarioId, ativa])
  @@map("recorrencias")
}

/// Uma compra ou venda de um ativo.
///
/// Cada linha é um EVENTO, não uma posição: a posição atual de um ticker é
/// a soma das compras menos as vendas. Guardar assim é o que permite ter
/// histórico e calcular preço médio depois de uma venda parcial.
///
/// A cotação atual não fica aqui de propósito: preço guardado envelhece em
/// minutos e passaria a mentir sobre o patrimônio.
model Operacao {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")

  /// Código na fonte de cotação: PETR4.SA, BTC-USD, HGLG11.SA.
  ativo     String

  /// Para somar a carteira por tipo de ativo.
  classe    ClasseDeAtivo

  tipo      TipoDeOperacao
  data      DateTime @db.Date

  /// 8 casas porque cripto se compra em fração: 0.00042 BTC é uma posição.
  quantidade Decimal @db.Decimal(18, 8)

  /// O que saiu do bolso (compra) ou entrou nele (venda), taxas incluídas.
  valor     Decimal @db.Decimal(12, 2)

  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Consolidar a carteira é sempre "as operações deste usuário, por ativo,
  // na ordem em que aconteceram".
  @@index([usuarioId, ativo, data])
  @@map("operacoes")
}

/// O que se faz com um ativo.
enum TipoDeOperacao {
  COMPRA
  VENDA
}

/// Em que cesta o ativo entra no resumo da carteira.
enum ClasseDeAtivo {
  ACAO
  FII
  CRIPTO
  ETF
  OUTRO
}
/// Se o dinheiro já se moveu. Um valor só serve para gasto e ganho: o rótulo
/// na tela é que muda — "A pagar/Pago" para gasto, "A receber/Recebido" para
/// ganho. Dois enums separados diriam a mesma coisa duas vezes.
enum StatusTransacao {
  PENDENTE
  CONCLUIDA
}

/// Gasto que se repete igual todo mês (aluguel, assinatura) ou que varia
/// (mercado, lazer). Serve para responder "quanto do meu mês já está preso?".
enum ClassificacaoGasto {
  FIXO
  VARIAVEL
}

enum TipoTransacao {
  GASTO
  GANHO
}
